#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define HOST_OS 1 //This must be before the include of zmk-helpers
#include <zmk-helpers/helper.h>

#include "hun_keys.h"

#define NAVLYR 1
#define NUMLYR 2
#define SYMLYR 3
#define FUNLYR 6

/ {
///////////////// HUNGARIAN CHARACTER COMBOS //////////////////////////////
        combos {  // ÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁÁ
            compatible = "zmk,combos";
/////////////////  SOFT OFF  //////////////////////////////
            combo_soft_off { // Soft off
                timeout-ms = <50>;
                key-positions = <36 38>;
                layers = <0>;
                bindings = <&soft_off>;
            };
            combo_jk_escape { // ESC if jk pressed as a combo 
                timeout-ms = <50>;
                key-positions = <19 20>;
                layers = <0>;
                bindings = <&kp ESC>;
            };
        };
///////////////////////////////////////////////////////////////////////////

        macros {
            back_word: back_word{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp BKSP>
                    , <&macro_release &kp LCTRL>
                ;
            }; 
            del_word: del_word{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp DEL>
                    , <&macro_release &kp LCTRL>
                ;
            }; 
            jmp_nxt_word: jmp_nxt_word{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp RIGHT>
                    , <&macro_release &kp LCTRL>
                ;
            }; 
            jmp_prev_word: jmp_prev_word{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp LEFT>
                    , <&macro_release &kp LCTRL>
                ;
            }; 
        };
        
        behaviors {
            bhm: balanced_homerow_mods {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <250>;    // <---[[moderate plus duration]]
                quick-tap-ms = <200>;
                flavor = "tap-preferred";
                bindings = <&kp>, <&kp>;
            };

            phm: pinky_homerow_mods {  // Pinky Home Row Mods
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <350>;    // <---[[even longer duration for pinky]]
                quick-tap-ms = <200>;
                flavor = "tap-preferred";
                bindings = <&kp>, <&kp>;
            };

            ltc: layer_tap_custom {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <260>;
                quick-tap-ms = <200>;
                flavor = "tap-preferred";
                bindings = <&mo>, <&kp>;
            };
            
            eptog: extpwr_tog {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&ext_power EP_TOG>, <&ext_power EP_OFF>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
            }; 

            outtog: output_tog {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&out OUT_TOG>, <&out OUT_USB>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
            }; 

            osl_mo: osl_mo {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <260>;
                quick-tap-ms = <200>;
                flavor = "hold-preferred";
                bindings = <&mo>, <&sl>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {  //LAYER 0
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// |  SYM |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | ESC | SPC | TAB |   | ENT | BKSP  | DEL |
                        bindings = <
   &none                    &kp Q    &kp W         &kp E         &kp R    &kp T           &kp Y    &kp U           &kp I              &kp O    &kp P       &kp DEL
   &osl_mo SYMLYR SYMLYR    &kp A    &kp S         &kp D         &kp F    &kp G           &kp H    &kp J           &kp K              &kp L    &kp SEMI    &osl_mo SYMLYR SYMLYR
   &kp LSHFT                &kp Z    &bhm LGUI X   &bhm LALT C   &kp V    &kp B           &kp N    &bhm LCTRL M    &bhm LALT COMMA    &kp DOT  &kp FSLH    &ltc FUNLYR MINUS
                        &kp LCTRL  &ltc NAVLYR SPC  &ltc NUMLYR TAB                                        &kp RET   &kp BSPC &kp RSHFT
                        >;
                };


                nav_layer {  //LAYER 1
// -----------------------------------------------------------------------------------------
// |  TAB |      |      |       |        |   |||  REDO | PASTE  | COPY |  CUT  |   UNDO  | BKSP |
// | CTRL | LGUI | LALT | LCTRL | LSHIFT |   |||  LEFT |  DOWN  |  UP  | RIGHT | CAPSLCK |  `   |
// | SHFT |      |      |       |        |   |||  HOME | PGDOWN | PGUP |  END  |  INSERT |  ~   |
//                    | ESC |     | TAB |            | ENT | BKSP | DEL |
                        bindings = <
   &none    &none        &none         &none          &none      &none           &back_word         &kp PAGE_UP    &kp PAGE_DOWN    &del_word        &none        &none
   &none    &kp HOME     &none         &none          &kp END    &none           &kp LEFT           &kp DOWN       &kp UP           &kp RIGHT        &kp LCAPS    &kp GRAVE
   &none    &kp K_CUT    &kp K_COPY    &kp K_PASTE    &none      &none           &jmp_prev_word     &none          &none            &jmp_nxt_word     &none        &none
                               &none &none   &none                                       &none   &none    &none
                        >;
                };

                num_layer { //LAYER 2
// -----------------------------------------------------------------------------------------
// |  TAB |      |      |       |        |   |||    SLASH   | N7 | N8 | N9 |  MINUS    | BKSP |
// | CTRL | LGUI | LALT | LCTRL | LSHIFT |   |||    STAR    | N4 | N5 | N6 |  PLUS |  `   |
// | SHFT |      |      |       |        |   |||    PERCENT | N1 | N2 | N3 |  EQUAL   |  ~   |
//                    | ESC |     |    |              | PERIOD | N0 | MINUS |
                        bindings = <
   &none    &none    &none    &none    &none    &none          &kp SLASH      &kp N7  &kp N8  &kp N9    &kp MINUS    &none
   &none    &none    &none    &none    &none    &none          &kp STAR       &kp N4  &kp N5  &kp N6    &kp PLUS     &none
   &none    &none    &none    &none    &none    &none          &kp PERCENT    &kp N1  &kp N2  &kp N3    &kp EQUAL    &none
                           &none   &none   &none                         &kp RET   &kp N0   &kp PERIOD
                        >;
                };

                sym_layer {  //LAYER 3
// -----------------------------------------------------------------------------------------
// |  TAB |  ~  |     |  [  |  ]  |  |   |||    |        |       |      |      | BKSP |
// | CTRL |  @  |  ^  |  (  |  )  |  _   |||    | LSHIFT | LCTRL | LALT | LGUI | `'   |
// | SHFT |  $  |  *  |  {  |  }  |  :   |||    |        |       |      |      | ESC  |
//                 |  #  |  +  |  !  |              |  |   |   |
                        bindings = <
   &none    &kp BSLH         &hu_e_acute         &kp LBRC    &kp RBRC     &kp APOSTROPHE              &kp TILDE        &hu_u_acute       &hu_i_acute    &hu_o_acute       &kp GRAVE          &kp DEL
   &none    &hu_a_acute      &kp DOLLAR          &kp LPAR    &kp RPAR     &kp DOUBLE_QUOTES           &kp HASH         &hu_u_umlaut      &kp PIPE       &hu_o_umlaut      &kp EXCLAMATION    &none
   &kp LSHFT    &kp LESS_THAN    &kp GREATER_THAN    &kp LBKT    &kp RBKT     &kp AT_SIGN             &kp AMPERSAND    &hu_u_dblacute    &none          &hu_o_dblacute    &kp QUESTION       &none
                                              &kp LCTRL   &kp SPC    &kp TAB                                 &kp RET  &kp BSPC   &kp LSHFT
                        >;
                };

                mouse_layer {  // LAYER 4    //This is not ready!!!!!!!!!!!!!!!!
// -----------------------------------------------------------------------------------------
// |  TAB |      |      |       |        |   |||    REDO   | PASTE | COPY | CUT    |  UNDO  | BKSP |
// | CTRL | LGUI | LALT | LCTRL | LSHIFT |   |||    LEFT   | DOWN  |  UP  | RIGHT  |        |  `   |
// | SHFT |      |      |       |        |   |||    LEFT2  | DOWN2 | UP2  | RIGHT2 |        |  ~   |
//                    | ESC |     |    |              | LEFTBUTT | MIDBUTT | RIGHTBUTT |
                        bindings = <
   &kp  TAB  &none       &none     &none      &none     &none          &none      &none  &none  &none     &none     &kp BSPC
   &kp LCTRL &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none          &none     &none  &none  &none   &none  &kp GRAVE
   &kp LSHFT  &none      &none     &none      &none     &none          &none  &none  &none  &none    &none     &kp TILDE
                  &none &none   &none                                          &none   &none   &none
                        >;
                };

                media_layer { //LAYER 5
// -----------------------------------------------------------------------------------------
// |  TAB |  BT4   |    BT5     |   BT6    |        | BT_CLR_ALL  |||    |        |       |      |      | BKSP |
// | CTRL |  PREV  |  VOL_DOWN  |  VOL_UP  |  NEXT  |  EP_TGL     |||    | LSHIFT | LCTRL | LALT | LGUI | `'   |
// | SHFT |  BT0   |    BT1     |   BT2    |   BT3  |  OUT_TOG    |||    |        |       |      |      | ESC  |
//                 |  STOP  |  PLAY  |  MUTE  |                                       |  |   |   |
                        bindings = <
   &kp  TAB    &bt BT_SEL 4  &bt BT_SEL 5  &bt BT_SEL 6   &bt BT_CLR      &bt BT_CLR_ALL        &none   &none        &none     &none     &none    &kp BSPC
   &kp LCTRL    &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP   &kp C_NEXT        &eptog              &none &kp LSHIFT   &kp LCTRL  &kp LALT  &kp LGUI  &kp GRAVE 
   &kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &outtog             &none   &none        &none     &none     &none    &kp TILDE
                      &kp C_STOP &kp C_PLAY_PAUSE   &kp C_MUTE                                              &none  &none   &none
                        >;
                };

                fun_layer {  //LAYER 6
// -----------------------------------------------------------------------------------------
// |  TAB |  F12  |  F7  |  F8  |  F9  | PrtScr    |||    |        |       |      |      | BKSP |
// | CTRL |  F11  |  F4  |  F5  |  F6  | ScrLck    |||    | LSHIFT | LCTRL | LALT | LGUI | `'   |
// | SHFT |  F10  |  F1  |  F2  |  F3  | PAUSE     |||    |        |       |      |      | ESC  |
//                 |  #  |  +  |  !  |              |  |   |   |
                        bindings = <
   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6           &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12
   &none     &none     &none     &none     &none     &none            &none     &none     &none     &none      &none      &none
   &none     &none     &none     &none     &none     &none            &none     &none     &none     &none      &none      &none
                                 &none   &none   &none                    &none  &none   &none
                        >;
                };

        };
};
