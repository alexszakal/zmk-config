        //
        //     combo_o_dblacute { // ŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐŐ
        //         timeout-ms = <50>;
        //         key-positions = <9 21>;
            //     layers = <0>;
            //     bindings = <&hu_o_dblacute>;
